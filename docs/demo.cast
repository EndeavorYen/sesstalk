{"version": 2, "width": 88, "height": 32, "title": "sesstalk demo"}
[0.05, "o", "sesstalk demo (isolated mailbox, no LLM)\n"]
[0.09, "o", "\n"]
[0.13, "o", "sesstalk send --from cursor-a --to claude --to codex --thread auth-review \\\n"]
[0.17, "o", "    --goal \"Ship refresh-token rotation\" \"please review src/auth.ts\"\n"]
[0.21, "o", "\n"]
[0.25, "o", "{\n"]
[0.29, "o", "  \"status\": \"queued\",\n"]
[0.33, "o", "  \"thread\": \"auth-review\",\n"]
[0.37, "o", "  \"audience\": [\n"]
[0.41, "o", "    \"claude\",\n"]
[0.45, "o", "    \"codex\"\n"]
[0.49, "o", "  ]\n"]
[0.53, "o", "}\n"]
[0.57, "o", "\n"]
[0.61, "o", "sesstalk receive --name claude\n"]
[0.65, "o", "{\n"]
[0.69, "o", "  \"status\": \"received\",\n"]
[0.73, "o", "  \"to\": \"claude\",\n"]
[0.77, "o", "  \"thread\": \"auth-review\"\n"]
[0.81, "o", "}\n"]
[0.85, "o", "\n"]
[0.89, "o", "sesstalk reply --from claude \"looks good, next is tests\"\n"]
[0.93, "o", "{\n"]
[0.97, "o", "  \"to\": \"cursor-a\",\n"]
[1.01, "o", "  \"thread\": \"auth-review\",\n"]
[1.05, "o", "  \"text\": \"looks good, next is tests\",\n"]
[1.09, "o", "  \"provenance\": {\n"]
[1.13, "o", "    \"peer\": \"claude\",\n"]
[1.17, "o", "    \"untrusted\": true,\n"]
[1.21, "o", "    \"depth\": 1\n"]
[1.25, "o", "  }\n"]
[1.29, "o", "}\n"]
[1.33, "o", "\n"]
[1.37, "o", "Next: two real chats, unique /as names, keep /receive open.\n"]
